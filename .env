# Ordain.church Environment Variables

# Database
DATABASE_URL=sqlite:///./ordainchurch.db

# JWT
JWT_SECRET=ordainchurch-jwt-secret-production-change-me-to-random-value
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# Google OAuth (configure these in Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple Sign-In (configure these in Apple Developer Portal)
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_TEAM_ID=
APPLE_KEY_ID=

# OpenRouter API (for AI ceremony generation)
OPENROUTER_API_KEY=${OPENROUTER_API_KEY}

# Stripe (Dual Mode - test/live)
STRIPE_MODE=test
STRIPE_TEST_SECRET_KEY=
STRIPE_LIVE_SECRET_KEY=
STRIPE_TEST_PUBLISHABLE_KEY=
STRIPE_LIVE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Redis (optional)
REDIS_URL=

# App
APP_URL=http://localhost:8001
