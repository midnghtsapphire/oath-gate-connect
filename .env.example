# Ordain.church / Oath Gate Connect — environment template
# Copy to .env and fill in real values. Never commit .env.

# Database (SQLite local default; Postgres in docker-compose)
DATABASE_URL=sqlite:///./ordainchurch.db

# JWT — required in production (no default secret)
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple Sign-In (optional)
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_TEAM_ID=
APPLE_KEY_ID=

# OpenRouter — AI ceremony builder
OPENROUTER_API_KEY=

# Stripe dual-mode billing (optional)
STRIPE_MODE=test
STRIPE_TEST_SECRET_KEY=
STRIPE_LIVE_SECRET_KEY=
STRIPE_TEST_PUBLISHABLE_KEY=
STRIPE_LIVE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Redis (optional)
REDIS_URL=redis://localhost:6379/0

# Public app URL (CORS allow-list uses this)
APP_URL=http://localhost:8001
CORS_ORIGINS=http://localhost:8001,http://localhost:8080,http://127.0.0.1:8001
